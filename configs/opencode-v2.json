{
  "$schema": "https://opencode.ai/config.json",
  "model": "sglang/qwen3.8-27b",
  "snapshots": false,
  "providers": {
    "sglang": {
      "name": "Local SGLang",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {"baseURL": "http://127.0.0.1:30000/v1"},
      "body": {"chat_template_kwargs": {"enable_thinking": false}, "temperature": 0},
      "models": {
        "qwen3.8-27b": {
          "capabilities": {"tools": true, "input": ["text"], "output": ["text"]},
          "limit": {"context": 30000, "output": 4096}
        }
      }
    }
  },
  "agents": {
    "build": {"model": "sglang/qwen3.8-27b"},
    "title": {"model": "sglang/qwen3.8-27b"},
    "summary": {"model": "sglang/qwen3.8-27b"},
    "compaction": {"model": "sglang/qwen3.8-27b"}
  },
  "permissions": [
    {"action": "*", "resource": "*", "effect": "deny"},
    {"action": "read", "resource": "*", "effect": "allow"},
    {"action": "glob", "resource": "*", "effect": "allow"},
    {"action": "grep", "resource": "*", "effect": "allow"},
    {"action": "execute", "resource": "*", "effect": "allow"},
    {"action": "edit", "resource": "calculator.py", "effect": "allow"},
    {"action": "shell", "resource": "python3 -m unittest -q", "effect": "allow"}
  ]
}
