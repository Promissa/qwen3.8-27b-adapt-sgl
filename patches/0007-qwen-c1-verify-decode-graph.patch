+@triton.jit
+def _build_c1_verify_decode_indices(
+    PrefixPtr, PrefixIds, DraftIds, Mask, Ptr, Ids, Splits,
+    ROWS: tl.constexpr, TILE: tl.constexpr, BLOCK: tl.constexpr,
+):
+    """Compact each query's shared prefix and its visible draft ancestors."""
+    row = tl.program_id(0)
+    part = tl.program_id(1)
+    prefix = tl.load(PrefixPtr + 1)
+    cols = tl.arange(0, ROWS)
+    # The deterministic Triton target uses FULL_MASK with an all-visible prefix.
+    mask_rows = tl.arange(0, ROWS)
+    ancestors = tl.load(Mask + mask_rows[:, None] * (prefix + ROWS) + prefix + cols[None, :]) != 0
+    counts = tl.sum(ancestors.to(tl.int32), axis=1)
+    start = row * prefix + tl.sum(tl.where(mask_rows < row, counts, 0), axis=0)
+    count = prefix + tl.sum(tl.where(mask_rows == row, counts, 0), axis=0)
+    for block in range(part, tl.cdiv(prefix, BLOCK), tl.num_programs(1)):
+        i = block * BLOCK + tl.arange(0, BLOCK)
+        values = tl.load(PrefixIds + i, mask=i < prefix, other=0)
+        tl.store(Ids + start + i, values, mask=i < prefix)
+    if part == 0:
+        visible = tl.load(Mask + row * (prefix + ROWS) + prefix + cols) != 0
+        offsets = tl.cumsum(visible.to(tl.int32)) - 1
+        tl.store(Ids + start + prefix + offsets, tl.load(DraftIds + cols), mask=visible)
+        tl.store(Ptr + row, start)
+        if row == ROWS - 1:
+            tl.store(Ptr + ROWS, start + count)
+        tl.store(Splits + row, tl.cdiv(count, TILE))
+
